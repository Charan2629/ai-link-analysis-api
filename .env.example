# Google Gemini API Key (Primary Provider - Required)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Configuration
# Primary model: gemini-3.5-flash-lite (fastest, lowest cost, native JSON)
GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback model for retry or complex reasoning
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Groq API Configuration (Optional Cross-Provider Resilience Fallback)
# Provides ultra-fast failover when Gemini has 503/429 spikes.
# Obtain from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Server Configuration
HOST=0.0.0.0
PORT=4000

# Extraction & Scraping Settings
REQUEST_TIMEOUT_SECONDS=15
MAX_CONTENT_CHARS=12000

# Cache Settings
CACHE_TTL_SECONDS=3600
CACHE_MAXSIZE=1000
